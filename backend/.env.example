# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# Optional: SMTP settings so contact form submissions also arrive by email.
# If left blank, submissions are still saved to backend/db.json and the form
# will still work - you just won't get an email notification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=sivananthan.20230297@iit.ac.lk
